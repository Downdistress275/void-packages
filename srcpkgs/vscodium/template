# Template file for vscodium aarch64
pkgname=vscodium
version=1.135.06055
revision=1
only_for_archs="aarch64"
create_wrksrc=yes
depends="gtk+3 nss alsa-lib libsecret libxkbfile xdg-utils libXScrnSaver"
short_desc="Community build of VS Code without Microsoft telemetry"
maintainer="Downdistress275 <fixing-striped0l@icloud.com>"
license="MIT"
homepage="https://vscodium.com"
distfiles="https://github.com/VSCodium/vscodium/releases/download/${version}/VSCodium-linux-arm64-${version}.tar.gz"
checksum=9765cea4f707ff7dc83a40be408a7318a59abb6996b359631639d9aab2f48a90
nostrip=yes

do_install() {
	vmkdir opt/${pkgname}
	vcopy "*" opt/${pkgname}

	chmod 4755 ${DESTDIR}/opt/${pkgname}/chrome-sandbox

	vbin ${FILESDIR}/vscodium.sh codium
	ln -sf /usr/bin/codium ${DESTDIR}/usr/bin/vscodium

	vinstall ${FILESDIR}/vscodium.desktop 644 usr/share/applications
	vinstall ${FILESDIR}/vscodium-url-handler.desktop 644 usr/share/applications
	vinstall resources/app/resources/linux/code.png 644 usr/share/pixmaps vscodium.png
	
	vlicense resources/app/LICENSE.txt LICENSE

}

post_install() {
	for f in $(find ${DESTDIR}/opt/vscodium -type f); do
		readelf -d "$f" 2>/dev/null | grep -qE 'ld-linux-x86-64|ld64\.so' && echo "FOREIGN-ARCH: $f"
	done
}
